# ===============================================
# TAMIL NADU STALL FABRICATION ASSOCIATION (TNSFA)
# ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# ===============================================

# 1. SITE METADATA
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 2. EMAIL NOTIFICATION RECIPIENT
# Submissions from contact and membership forms are sent to this address:
SECRETARIAT_EMAIL=secretariat@tnsfa.org

# 3. PRODUCTION EMAIL SERVICE (Choose ONE: Resend or SMTP)

# Option A: Resend API (Recommended for Vercel)
# Sign up at https://resend.com, obtain an API key, and set:
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Option B: Standard SMTP (Gmail, Zoho, Hostinger, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="TNSFA Secretariat <secretariat@tnsfa.org>"
